ect\", \"properties\": {\"access_id\": {\"type\": \"string\"}, \"request_id\": {\"type\": \"string\", \"description\": \"Choose a unique ID per distinct write operation, e.g. action-record-ID. Reuse it only for retries of that SAME operation; do not use one task ID for all writes.\"}}, \"required\": [\"access_id\", \"request_id\"], \"additionalProperties\": false}}}, {\"type\": \"function\", \"function\": {\"name\": \"disable_user\", \"description\": \"Disable only after all assets and access are cleared.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"user_id\": {\"type\": \"string\"}, \"request_id\": {\"type\": \"string\", \"description\": \"Choose a unique ID per distinct write operation, e.g. action-record-ID. Reuse it only for retries of that SAME operation; do not use one task ID for all writes.\"}}, \"required\": [\"user_id\", \"request_id\"], \"additionalProperties\": false}}}]"
